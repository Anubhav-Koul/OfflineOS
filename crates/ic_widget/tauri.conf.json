{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IronClaw Desktop",
  "version": "0.1.0",
  "identifier": "dev.ironclaw.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
